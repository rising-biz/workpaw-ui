{
  "name": "workpaw-ui",
  "version": "1.2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme.css": "./src/styles/theme.css",
    "./theme-init.js": "./src/theme-init.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b",
    "preview": "vite preview",
    "lint": "node scripts/check-ui-stack.mjs && node scripts/check-theme-contracts.mjs && node scripts/check-contrast.mjs && node scripts/check-tailwind-preset.mjs && node scripts/check-component-forks.mjs && oxlint .",
    "check:ui-stack": "node scripts/check-ui-stack.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:theme-contracts": "node scripts/check-theme-contracts.mjs",
    "check:tailwind-preset": "node scripts/check-tailwind-preset.mjs",
    "check:forks": "node scripts/check-component-forks.mjs"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "shadcn",
    "workpaw"
  ],
  "author": "",
  "license": "ISC",
  "description": "WorkPaw shared UI components, hooks, and API types",
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.20.0",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "motion": "^12.0.0",
    "next-themes": "^0.4.0",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/node": "^4.3.1",
    "@tailwindcss/oxide": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "motion": "12.42.2",
    "next-themes": "0.4.6",
    "oxlint": "^1.83.0",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "zustand": "5.0.14"
  },
  "packageManager": "pnpm@11.11.0",
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rising-biz/workpaw-ui.git"
  },
  "engines": {
    "node": ">=20.19"
  }
}
